# 复制为 .env 后修改
PORT=8787
# 开发模式固定使用 8788，避免与服务器上正在运行的 8787 端口冲突
DATA_DIR=./data

ADMIN_USER=your-name
ADMIN_PASSWORD=change-me-to-a-long-password

# 本地开发免密登录；生产环境不会生效。设为 false 可关闭。
DEV_GUEST_LOGIN=true

# 32 位以上随机字符串，生成方式：node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# 联系方式加密密钥，换了以后旧数据无法解密，请妥善保存
CONTACT_KEY=

# 对外访问地址，例如 https://your-domain.com
PUBLIC_BASE_URL=

# systemd | pm2 | docker | none，留空自动判断
DEPLOY_MODE=

# 是否部署在 Nginx 等反向代理后面；直接对公网监听时保持 false
TRUST_PROXY=false

# 后台登录有效期，单位秒；默认 2592000（30 天）
SESSION_TTL=2592000

# 报告分析：DeepSeek
# 不配置时会自动回退到模板报告
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 联网检索：博查 Bocha
# 不配置时仍会生成报告，但不会联网核对
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bochaai.com/v1

# AI 单次请求超时时间，单位毫秒
AI_TIMEOUT_MS=120000
