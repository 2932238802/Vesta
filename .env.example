# 复制为 .env 后修改
PORT=8787
# 开发模式固定使用 8788，避免与服务器上正在运行的 8787 端口冲突
DATA_DIR=./data

ADMIN_USER=your-name
ADMIN_PASSWORD=change-me-to-a-long-password

# 本地开发免密登录；生产环境不会生效。设为 false 可关闭。
DEV_GUEST_LOGIN=true

# 32 位以上随机字符串，生成方式：node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# 联系方式加密密钥，换了以后旧数据无法解密，请妥善保存
CONTACT_KEY=

# 对外访问地址，例如 https://your-domain.com
PUBLIC_BASE_URL=

# systemd | pm2 | docker | none，留空自动判断
DEPLOY_MODE=

# 是否部署在 Nginx 等反向代理后面；直接对公网监听时保持 false
TRUST_PROXY=false

# 后台登录有效期，单位秒；默认 2592000（30 天）
SESSION_TTL=2592000

# 报告分析：OpenAI 兼容接口
# 优先读 AI_*；也兼容旧的 DEEPSEEK_* 变量名。
# 不配置就无法生成 AI 报告，系统不会用模板假装生成成功。
# 本地开发建议指到 one-api 网关（也可放 WSL 全局 ~/.profile，见 docs/README.md）：
#   AI_BASE_URL=http://one-api.server22.jz/v1
#   AI_MODEL=deepseek-v4-flash    # 该网关没有 deepseek-chat，先查 $AI_BASE_URL/models
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
# 旧变量名（可留空，配置后同样生效）
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=
# DEEPSEEK_MODEL=

# 联网检索：博查 Bocha
# BOCHA_API_KEY 和 BOCHA_BASE_URL 必须同时配置；缺一个都会明确报错并允许重试。
# 检索的关键词、时间和来源链接会写进报告，不做静默降级。
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bochaai.com/v1

# AI 单次请求超时时间，单位毫秒
AI_TIMEOUT_MS=120000
