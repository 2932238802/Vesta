{
  "name": "vesta",
  "private": true,
  "version": "1.75.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm --workspace server run dev",
    "dev:web": "npm --workspace web run dev",
    "build": "npm --workspace web run build",
    "typecheck": "npm --workspace server run typecheck && npm --workspace web run typecheck",
    "check:docs": "node scripts/check-docs.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:dates": "tsx shared/src/date.cases.ts && tsx shared/src/cycle.cases.ts",
    "check:audit": "tsx server/src/ai/doc-audit.cases.ts",
    "verify": "npm run check:docs && npm run check:size && npm run check:version && npm run check:dates && npm run check:audit && npm run typecheck && npm run build",
    "start": "npm --workspace server run start",
    "update": "bash update.sh"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "tsx": "^4.23.15"
  }
}
